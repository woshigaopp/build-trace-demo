# Frontend (Vercel or frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8080

# Backend model provider (Railway or shell environment)
APP_AI_BASE_URL=https://api.siliconflow.cn/v1
APP_AI_API_KEY=
APP_AI_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
APP_AI_TIMEOUT=120s

# Backend browser access. In production, use the exact Vercel origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend database. Local defaults to H2; production should use Neon PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/buildtrace;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
