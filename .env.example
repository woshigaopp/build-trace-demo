# Frontend (Vercel or frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8080

# Backend model provider (Railway or shell environment)
APP_AI_PROVIDER=api
APP_AI_BASE_URL=https://api.siliconflow.cn/v1
APP_AI_API_KEY=
APP_AI_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
APP_AI_TIMEOUT=120s

# Local-only Codex CLI mode. Do not expose this provider on a public server.
APP_AI_CODEX_EXECUTABLE=codex
APP_AI_CODEX_MODEL=
APP_AI_CODEX_REASONING_EFFORT=medium

# Backend browser access. In production, use the exact Vercel origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use a random value of at least 32 characters in every deployed environment.
APP_AUTH_JWT_SECRET=replace-with-a-random-production-secret-at-least-32-characters
APP_AUTH_TOKEN_TTL=7d

# Backend database. Local defaults to H2; production should use Neon PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/buildtrace;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
